generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  // ---------------------------------------------------------------------------
  // Identity
  // ---------------------------------------------------------------------------

  name      String  @db.VarChar(100)
  email     String  @unique @db.VarChar(150)
  avatarUrl String? @map("avatar_url") @db.Text

  // ---------------------------------------------------------------------------
  // Authentication
  // ---------------------------------------------------------------------------

  passwordHash    String    @map("password_hash") @db.VarChar(255)
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamp(6)

  // ---------------------------------------------------------------------------
  // Employment
  // ---------------------------------------------------------------------------

  jobTitle String? @map("job_title") @db.VarChar(100)

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  hireDate DateTime? @map("hire_date") @db.Date

  // ---------------------------------------------------------------------------
  // Permissions
  // ---------------------------------------------------------------------------

  role UserRole @default(employee)

  status UserStatus @default(active)

  // ---------------------------------------------------------------------------
  // Audit
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // ---------------------------------------------------------------------------
  // Relations
  // ---------------------------------------------------------------------------

  usageLogs UsageLog[]

  accessRequests AccessRequest[] @relation("RequestedBy")

  processedRequests AccessRequest[] @relation("ProcessedBy")

  userToolAccesses UserToolAccess[] @relation("ToolAccessUser")

  grantedToolAccesses UserToolAccess[] @relation("ToolAccessGrantedBy")

  revokedToolAccesses UserToolAccess[] @relation("ToolAccessRevokedBy")

  @@index([departmentId], map: "idx_users_department")
  @@index([status], map: "idx_users_status")
  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  description String?
  slug        String  @unique @db.VarChar(100)

  users User[]
  tools Tool[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("departments")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  description String?

  tools Tool[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("categories")
}

model Tool {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(100)
  description String?
  vendor      String? @db.VarChar(100)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  ownerDepartmentId String     @map("owner_department_id")
  ownerDepartment   Department @relation(fields: [ownerDepartmentId], references: [id])

  monthlyCost       Decimal  @default(0) @map("monthly_cost") @db.Decimal(10, 2)
  previousMonthCost Decimal? @map("previous_month_cost") @db.Decimal(10, 2)
  activeUsersCount  Int      @default(0) @map("active_users_count")

  websiteUrl String? @map("website_url")
  iconUrl    String? @map("icon_url")

  status ToolStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  usageLogs        UsageLog[]
  accessRequests   AccessRequest[]
  userToolAccesses UserToolAccess[]
  costTrackings    CostTracking[]

  @@index([categoryId], map: "idx_tools_category")
  @@index([ownerDepartmentId], map: "idx_tools_owner_department")
  @@index([status], map: "idx_tools_status")
  @@map("tools")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccessRequest {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("RequestedBy", fields: [userId], references: [id])

  toolId String @map("tool_id")
  tool   Tool   @relation(fields: [toolId], references: [id])

  processedById String? @map("processed_by_id")
  processedBy   User?   @relation("ProcessedBy", fields: [processedById], references: [id])

  status        RequestStatus @default(pending)
  reviewComment String?       @map("review_comment") @db.Text
  reason        String?       @db.Text

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamp(6)
  processedAt DateTime? @map("processed_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([userId], map: "idx_access_requests_user")
  @@index([toolId], map: "idx_access_requests_tool")
  @@index([processedById], map: "idx_access_requests_processed_by")
  @@index([status], map: "idx_access_requests_status")
  @@map("access_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CostTracking {
  id String @id @default(cuid())

  toolId String @map("tool_id")
  tool   Tool   @relation(fields: [toolId], references: [id])

  month DateTime @db.Date

  cost        Decimal @db.Decimal(10, 2)
  userCount   Int     @default(0) @map("user_count")
  costPerUser Decimal @default(0) @map("cost_per_user") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([toolId, month], map: "unique_tool_month_cost")
  @@index([toolId], map: "idx_cost_tracking_tool")
  @@index([month], map: "idx_cost_tracking_month")
  @@map("cost_tracking")
}

model UsageLog {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  toolId String @map("tool_id")
  tool   Tool   @relation(fields: [toolId], references: [id])

  usageDate    DateTime @map("usage_date") @db.Date
  sessionCount Int      @default(0) @map("session_count")
  totalMinutes Int      @default(0) @map("total_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([userId], map: "idx_usage_logs_user")
  @@index([toolId], map: "idx_usage_logs_tool")
  @@index([usageDate], map: "idx_usage_logs_date")
  @@map("usage_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model UserToolAccess {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("ToolAccessUser", fields: [userId], references: [id])

  toolId String @map("tool_id")
  tool   Tool   @relation(fields: [toolId], references: [id])

  status AccessStatus @default(active)

  grantedById String? @map("granted_by_id")
  grantedBy   User?   @relation("ToolAccessGrantedBy", fields: [grantedById], references: [id])

  revokedById String? @map("revoked_by_id")
  revokedBy   User?   @relation("ToolAccessRevokedBy", fields: [revokedById], references: [id])

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([userId, toolId], map: "unique_user_tool_access")
  @@index([userId], map: "idx_user_tool_access_user")
  @@index([toolId], map: "idx_user_tool_access_tool")
  @@index([status], map: "idx_user_tool_access_status")
  @@map("user_tool_access")
}

enum AccessStatus {
  active
  revoked
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum UserRole {
  employee
  manager
  admin
}

enum UserStatus {
  active
  inactive
}

enum ToolStatus {
  active
  unused
  expiring
}
