# Copy to .env.staging at the repository root (ignored by Git).
# HTTPS origin, without trailing slash.
STAGING_ORIGIN=https://tools-staging.example.com
# Generate TWO independent values with: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD because it is also embedded in DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
FRONTEND_PORT=3200
API_PORT=3201
