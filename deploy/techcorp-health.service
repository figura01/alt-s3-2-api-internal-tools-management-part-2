[Unit]
Description=Read-only TechCorp health diagnostic
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /home/ubuntu/.local/bin/techcorp-health.py
TimeoutStartSec=300
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

