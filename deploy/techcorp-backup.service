[Unit]
Description=Daily TechCorp PostgreSQL and configuration backups
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /home/ubuntu/.local/bin/techcorp-backup.py
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/backups/techcorp
